{
  "contract": "hatsu.pr-sections/v1",
  "$comment": "HA#351, rulings 2026-10-19. One catalogue owns reader ids, templates, titles, job families, precedence and every default cell. Reader max excludes footer blocks. Conditional run facts come from Mukai. Nen half NN#448 is merged; interim scripts remain until a released pin carries its verbs.",
  "max": 7,
  "proseBudget": 150,
  "aspects": [
    "Observability",
    "Security",
    "Traceability",
    "End-user experience",
    "Autonomy",
    "Stability",
    "Performance",
    "Maintainability",
    "Cost",
    "Portability",
    "Accessibility"
  ],
  "sections": [
    {
      "id": "changes",
      "glyph": "✨",
      "title": "What this changes for you",
      "level": 1,
      "template": "templates/pr-body/changes.md",
      "$comment": "Before/After for a named consumer; Case for/Case against; what would flip the decision."
    },
    {
      "id": "why",
      "glyph": "🧭",
      "title": "Why",
      "level": 2,
      "template": "templates/pr-body/why.md",
      "$comment": "Source/What it showed/Why it matters now, followed by the authoring nature."
    },
    {
      "id": "how",
      "glyph": "🛠️",
      "title": "How",
      "level": 2,
      "template": "templates/pr-body/how.md",
      "$comment": "Mermaid structure diagram and Item/Kind/Change legend; flow diagram only when behavior flow changed; one rejected alternative."
    },
    {
      "id": "improves",
      "glyph": "📈",
      "title": "What this improves",
      "level": 2,
      "template": "templates/pr-body/improves.md",
      "$comment": "All eleven aspects, marked ⬆ improves / ➖ unchanged / ⬇ regresses; justify only movement."
    },
    {
      "id": "verify",
      "glyph": "✅",
      "title": {
        "product": "How to verify",
        "library": "How a consumer verifies",
        "process": "What the guards prove",
        "unknown": "How a consumer verifies"
      },
      "level": 2,
      "template": "templates/pr-body/verify.md",
      "$comment": "Product: numbered steps. Library: Consumer scenario/Call or import/Expected, plus published artifact command. Process: Behavior changed/Lane or verb run/Refuses on/Passes on."
    },
    {
      "id": "evidence",
      "glyph": "📸",
      "title": "Evidence",
      "level": 2,
      "template": "templates/pr-body/evidence.md",
      "$comment": "UZF-26 state/variant evidence table; only where project.evidence.globs is declared.",
      "when": "evidence"
    },
    {
      "id": "compat",
      "glyph": "🔄",
      "title": "Compatibility & migration",
      "level": 2,
      "template": "templates/pr-body/compat.md",
      "$comment": "Symbol/Before/After/Consumer action; semver verdict."
    },
    {
      "id": "across",
      "glyph": "🌐",
      "title": "Across repositories",
      "level": 2,
      "template": "templates/pr-body/across.md",
      "$comment": "What another repository does differently after this merge; recorded rulings.",
      "when": "policy-hit"
    },
    {
      "id": "release-unit",
      "glyph": "📦",
      "title": "The release unit",
      "level": 2,
      "template": "templates/pr-body/release-unit.md",
      "$comment": "Artifact/Size/Provenance; CON-22 fan-out."
    },
    {
      "id": "rollout",
      "glyph": "🚀",
      "title": "Rollout & rollback",
      "level": 2,
      "template": "templates/pr-body/rollout.md",
      "$comment": "Target/Flag/Rollback step."
    },
    {
      "id": "economics",
      "glyph": "💰",
      "title": "Economics",
      "level": 2,
      "template": "templates/pr-body/economics.md",
      "$comment": "Leorio summary, then the full report in details; no new level-2 headings inside it.",
      "when": "economics"
    }
  ],
  "footer": [
    {
      "id": "delivery",
      "glyph": "📬",
      "title": "Delivery",
      "level": 2,
      "template": "templates/pr-body/delivery.md",
      "reserved": true,
      "$comment": "Reserved for HA#321; activation and rendering stay in that issue."
    },
    {
      "id": "checklist",
      "glyph": "📋",
      "title": "Completion checklist",
      "level": 2,
      "template": "templates/pr-body/checklist.md",
      "reserved": false,
      "$comment": "Compact evidence-backed completion conditions."
    },
    {
      "id": "issues",
      "glyph": "🔗",
      "title": "Associated issues",
      "level": 2,
      "template": "templates/pr-body/issues.md",
      "reserved": false,
      "$comment": "Canonical issue URL/scope/merging verdict table and closing lines; Development guard applies."
    },
    {
      "id": "attribution",
      "glyph": "🤝",
      "title": "Agent attribution",
      "level": 2,
      "template": "templates/pr-body/attribution.md",
      "reserved": false,
      "$comment": "Final heading; exact participant ledger from docs/AGENT-ATTRIBUTION.md."
    }
  ],
